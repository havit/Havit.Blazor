@namespace Havit.Blazor.Components.Web.Bootstrap

<div class="progress" role="progressbar" style="width: @($"{GetNormalizedValue()}%;") height: @($"{ProgressBarContainer.Height}px;")" aria-label="@Label" aria-valuenow="@FormatAriaValue(Value)" aria-valuemin="@FormatAriaValue(MinValueEffective)" aria-valuemax="@FormatAriaValue(MaxValueEffective)">
    <div class="@CssClassHelper.Combine("progress-bar", GetStripedCssClass(), (Color ?? ThemeColor.None).ToThemeCss(), CssClass)">@Label @ChildContent</div>
</div>
