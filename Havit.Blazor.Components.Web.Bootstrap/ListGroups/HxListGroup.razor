@namespace Havit.Blazor.Components.Web.Bootstrap

@{
	RenderFragment listGroupTemplate = @<div class="@GetClasses()" @attributes="this.AdditionalAttributes">
		<CascadingValue Value="this" TValue="HxListGroup" IsFixed="true">
			@ChildContent
		</CascadingValue>
	</div>;
}

@if (RenderContainsInlineWrapper)
{
	<div class="contains-inline">
		@listGroupTemplate
	</div>
}
else
{
	@listGroupTemplate
}
