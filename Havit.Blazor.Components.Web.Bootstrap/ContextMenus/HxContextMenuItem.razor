@namespace Havit.Blazor.Components.Web.Bootstrap
@using Havit.Blazor.Components.Web.Infrastructure;

@{
	bool enabledEffective = CascadeEnabledComponent.EnabledEffective(this);
}

@if (!String.IsNullOrEmpty(Href))
{
	<a class="@CssClassHelper.Combine("menu-item", "hx-context-menu-item", enabledEffective ? null : "disabled", CssClass)"
	   href="@Href"
	   aria-disabled="@(enabledEffective ? null : "true")"
	   tabindex="@(enabledEffective ? null : "-1")"
	   @onclick="HandleClick"
	   @onclick:stopPropagation="@OnClickStopPropagation">
		@RenderContent()
	</a>
}
else
{
	<button type="button"
			class="@CssClassHelper.Combine("menu-item", "hx-context-menu-item", enabledEffective ? null : "disabled", CssClass)"
			disabled="@(!enabledEffective)"
			@onclick="HandleClick"
			@onclick:stopPropagation="@OnClickStopPropagation">
		@RenderContent()
	</button>
}

@code {
	private RenderFragment RenderContent() => @<text>
		@if (Icon is not null)
		{
			<HxIcon Icon="Icon" CssClass="@CssClassHelper.Combine("menu-item-icon", IconCssClass)" />
		}
		@Text
		@ChildContent
	</text>;
}
