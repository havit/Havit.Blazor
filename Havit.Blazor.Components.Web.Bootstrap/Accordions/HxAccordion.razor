@namespace Havit.Blazor.Components.Web.Bootstrap
<div id="@Id" class="@CssClassHelper.Combine("hx-accordion", "accordion", (Size == AccordionSize.Small) ? "accordion-sm" : null, Flush ? "accordion-flush" : null, Gap ? "accordion-gap" : null, Color?.ToThemeCss(), CssClass)">
	<CascadingValue Value="this" IsFixed="true">
		@ChildContent
	</CascadingValue>
</div>