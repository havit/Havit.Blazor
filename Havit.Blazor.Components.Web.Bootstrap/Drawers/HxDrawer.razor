@namespace Havit.Blazor.Components.Web.Bootstrap

@* aria-labelledby precedes @attributes, so a caller-supplied value (e.g. for a heading in HeaderTemplate) wins *@
<dialog @ref="_drawerElement"
     aria-labelledby="@(String.IsNullOrEmpty(Title) ? null : _titleId)"
     @attributes="AdditionalAttributes"
     class="@CssClassHelper.Combine(GetDrawerResponsiveCssClass(), GetPlacementCssClass(), GetSizeCssClass(), SheetEffective ? "drawer-sheet" : null, InstantEffective ? "drawer-instant" : null, TranslucentEffective ? "drawer-translucent" : null, CssClassEffective)"
     tabindex="-1"
     data-bs-backdrop="@GetBackdropSetupValue(BackdropEffective)">
    @if (_opened || (RenderMode == DrawerRenderMode.Always) || (ResponsiveBreakpointEffective != DrawerResponsiveBreakpoint.None))
    {
        <div class="@CssClassHelper.Combine("drawer-header", HeaderCssClassEffective)">
            @if (!String.IsNullOrEmpty(Title))
            {
                <h5 class="drawer-title" id="@_titleId">@Title</h5>
            }
            @HeaderTemplate

            @if (ShowCloseButtonEffective)
            {
                if (CloseButtonIconEffective is null)
                {
                    <button type="button" class="btn-close hx-drawer-close-button" aria-label="Close" @onclick="HandleCloseButtonClick"></button>
                }
                else
                {
                    <button type="button" class="hx-drawer-custom-close-btn btn-close d-flex align-items-center" aria-label="Close" @onclick="HandleCloseButtonClick">
                        <HxIcon Icon="CloseButtonIconEffective" />
                    </button>
                }
            }
        </div>
        @if (BodyTemplate != null)
        {
            <div class="@CssClassHelper.Combine("drawer-body", BodyCssClassEffective)">
                @BodyTemplate
            </div>
        }
        @if (FooterTemplate != null)
        {
            <div class="@CssClassHelper.Combine("drawer-footer", FooterCssClassEffective)">
                @FooterTemplate
            </div>
        }
    }
</dialog>
