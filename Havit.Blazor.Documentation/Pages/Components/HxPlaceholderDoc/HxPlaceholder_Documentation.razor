@attribute [Route("/components/" + nameof(HxPlaceholderContainer))]
@attribute [Route("/components/" + nameof(HxPlaceholderButton))]

<ApiDoc Type="typeof(HxPlaceholder)">
    <DocHeading Title="Basic usage" />
	<p>
		<code>HxPlaceholderContainer</code> renders <code>aria-hidden="true"</code> while <code>Active</code>, so assistive technologies skip the placeholders.
		Swapping the placeholders for the loaded content (and announcing the change, if needed) is up to you.
	</p>
	<Demo Type="typeof(HxPlaceholder_Demo_BasicExample)" Tabs="false" />

    <DocHeading Title="Width" />
	<p>You can change the width using the <code>Columns</code> parameter (+ responsive variants with breakpoints).</p>
	<Demo Type="typeof(HxPlaceholder_Demo_Width)" Tabs="false" />

    <DocHeading Title="Color" />
	<Demo Type="typeof(HxPlaceholder_Demo_Colors)" />

    <DocHeading Title="Sizing" />
	<Demo Type="typeof(HxPlaceholder_Demo_Sizing)" Tabs="false" />

    <DocHeading Title="Animation" />
	<p>
		Use animations to better convey the perception of something being <i>actively</i> loaded.
		<code>PlaceholderAnimation.Wave</code> is the Bootstrap 6 default loading animation, <code>PlaceholderAnimation.Pulse</code> is an opacity pulse
		(<code>PlaceholderAnimation.Glow</code> is obsolete, an alias of <code>Pulse</code>).
	</p>
	<Demo Type="typeof(HxPlaceholder_Demo_Animation)" Tabs="false" />
</ApiDoc>

