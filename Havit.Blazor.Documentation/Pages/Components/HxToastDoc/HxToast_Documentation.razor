@attribute [Route("/components/" + nameof(HxToast))]
@attribute [Route("/components/" + nameof(HxToastContainer))]

<ApiDoc Type="typeof(HxToast)">
	<MainContent>
		<DocHeading Title="Basic usage" />
		<p>
			<code>HxToast</code> is usually not used directly, but as a part of <code>HxMessenger</code> component.
			See <a href="/components/@nameof(HxMessenger)">@nameof(HxMessenger) documentation</a>.
		</p>

		<DocHeading Title="Direct toast rendering" />
		<p>
			You can use <code>HxToast</code> directly to show a toast. Usually you will use it in combination with <code>HxToastContainer</code>.
		</p>
		<Demo Type="typeof(HxToast_Demo)" />

		<DocHeading Title="Placement" />
		<p>
			Use the <code>Position</code> parameter of <code>HxToastContainer</code> to place toasts in one of the nine standard positions
			(<code>TopStart</code>, <code>TopCenter</code>, <code>TopEnd</code>, <code>MiddleStart</code>, <code>MiddleCenter</code>,
			<code>MiddleEnd</code>, <code>BottomStart</code>, <code>BottomCenter</code>, <code>BottomEnd</code>).
			The container is fixed to the viewport, so the toast appears relative to the viewport. It also stays above an open modal <code>HxDialog</code> or <code>HxDrawer</code>
			(the container is moved to the browser top layer when a dialog opens).
			Multiple toasts placed in the same container stack vertically, spaced by <code>--bs-toast-spacing</code>.
		</p>
		<Demo Type="typeof(HxToast_Demo_Placement)" />

		<DocHeading Title="Color" />
		<p>
			Use the <code>Color</code> parameter for the Bootstrap 6 toast variants (colored border and subtle header).
			<code>ThemeColor.Danger</code> and <code>ThemeColor.Warning</code> toasts are announced to screen readers immediately (<code>role="alert"</code>),
			other toasts politely (<code>role="status"</code>).
		</p>
		<Demo Type="typeof(HxToast_Demo_Color)" />

		<DocAlert Type="DocAlertType.Info">
			<code>HxToast</code> supports static server rendering.
		</DocAlert>
	</MainContent>
	<CssVariables>
		<ApiDocCssVariable Name="--hx-toast-container-padding" Default="0.5rem">
			Padding of the container.
		</ApiDocCssVariable>
	</CssVariables>
</ApiDoc>

<ApiDoc Type="typeof(HxToastContainer)" />
