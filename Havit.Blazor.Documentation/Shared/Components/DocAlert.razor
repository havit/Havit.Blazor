<HxAlert Color="GetColor()" @attributes="AdditionalAttributes">
	<HxIcon Icon="GetBootstrapIcon()" CssClass="fs-lg lh-sm" />
	@* The Bootstrap 6 .alert is a flex container (icon + content): min-w-0 lets long content (e.g. code) wrap instead of overflowing the alert. *@
	<div class="min-w-0">
		@ChildContent
	</div>
</HxAlert>
