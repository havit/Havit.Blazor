@namespace Havit.Blazor.Documentation.Shared.Components
@using System.Globalization

@* Own <form role="search">: Safari's streamlined login auto-focuses the first field of what it takes for a login form
   on pages with an autocomplete="one-time-code" input (HxOtpInput docs); formless fields are grouped into a single form,
   so the navbar search was the first one. Submitting is prevented (HxAutosuggest handles Enter itself). *@
<form class="position-relative search-wrapper" role="search" @onsubmit:preventDefault>
	<HxAutosuggest @ref="_autosuggest"
				   Placeholder="Search"
				   TItem="SearchItem"
				   TValue="SearchItem"
				   @bind-Value="_selectedResult"
				   @bind-Value:after="NavigateToSelectedPage"
				   MinimumLength="0"
				   Delay="1"
				   CssClass="sidebar-search"
				   SearchIcon="BootstrapIcon.Search"
				   DataProvider="ProvideSuggestions">
		<ItemTemplate Context="searchItem"><span class="small">@searchItem.Title</span></ItemTemplate>
		<EmptyTemplate>
			@if (string.IsNullOrEmpty(_userInput))
			{
				<div class="p-3 fg-secondary small">
					Search for <strong>components</strong>, <strong>parameters</strong>, <strong>settings</strong>, <strong>enums</strong>, and more.
				</div>
			}
			else
			{
				<span class="p-2">No matches found</span>
			}
		</EmptyTemplate>
	</HxAutosuggest>
	<kbd class="search-shortcut-hint position-absolute top-50 translate-middle-y border rounded-4 bg-body fg-secondary fw-normal user-select-none py-0" style="right: 2.75rem; pointer-events: none;">@(_isMac ? "⌘K" : "Ctrl+K")</kbd>
</form>
