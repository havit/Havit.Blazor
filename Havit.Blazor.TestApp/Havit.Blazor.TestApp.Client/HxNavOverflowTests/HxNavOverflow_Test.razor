@page "/HxNavOverflow"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h4>HxNavOverflow E2E Tests</h4>

<div style="width: 360px;" data-testid="nav-overflow-container">
	<HxNavOverflow data-testid="nav-overflow-nav">
		@for (int i = 1; i <= 8; i++)
		{
			<HxNavLink Href="@($"#item{i}")" Text="@($"Item number {i}")" />
		}
	</HxNavOverflow>
</div>

<h5 class="mt-4">In a navbar drawer</h5>

<div style="max-width: 1100px;">
	<HxNavbar Id="nav-overflow-navbar">
		<HxNavbarBrand>Brand</HxNavbarBrand>
		<HxNavbarToggler data-testid="nav-overflow-navbar-toggler" />
		<HxNavbarDrawer>
			<HxNavOverflow data-testid="nav-overflow-navbar-nav">
				@for (int i = 1; i <= 12; i++)
				{
					<HxNavLink Href="@($"#navbar-item{i}")" Text="@($"Item number {i}")" />
				}
			</HxNavOverflow>
		</HxNavbarDrawer>
	</HxNavbar>
</div>
