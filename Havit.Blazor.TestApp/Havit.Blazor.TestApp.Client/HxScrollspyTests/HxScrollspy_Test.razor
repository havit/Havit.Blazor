@page "/HxScrollspyTests"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@* The sections must not end up under the sticky headers (scroll-padding-top of the scroll containers). *@
<style>
	.scrollspy-test-container {
		height: 300px;
		position: relative;
	}

	.scrollspy-test-padding {
		scroll-padding-top: 50px;
	}

	.scrollspy-test-padding-percent {
		scroll-padding-top: 20%;
	}

	.scrollspy-test-sticky-header {
		position: sticky;
		top: 0;
		height: 50px;
		z-index: 1;
		background: var(--bs-body-bg);
	}

	.scrollspy-test-inner {
		height: 200px;
		overflow-y: auto;
		scroll-padding-top: 30px;
		border: 4px solid gray;
	}
</style>

<h2>Sticky header in the HxScrollspy container (scroll-padding-top)</h2>
<HxNav Id="scrollspy-padding-nav">
	<HxScrollspyNavLink data-testid="padding-link-3" Href="#padding-section3">Section 3</HxScrollspyNavLink>
	<HxScrollspyNavLink data-testid="padding-link-1" Href="#padding-section1">Section 1</HxScrollspyNavLink>
</HxNav>
<div class="scrollspy-test-container">
	<HxScrollspy TargetId="scrollspy-padding-nav" CssClass="scrollspy-test-padding">
		<div class="scrollspy-test-sticky-header" data-testid="padding-header">Sticky header</div>
