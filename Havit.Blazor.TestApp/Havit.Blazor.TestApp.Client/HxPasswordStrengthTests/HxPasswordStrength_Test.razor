@page "/HxPasswordStrength"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<HxPasswordStrength ShowText="true" MinLength="_minLength" Strength="_staticStrength" OnStrengthChanged="HandleStrengthChanged">
	<HxInputText Label="Password" Type="InputType.Password" @bind-Value="_password" BindEvent="BindEvent.OnInput" />
</HxPasswordStrength>

<p data-testid="strength-output">@(_strength?.ToString() ?? "none")</p>

<HxButton Text="MinLength 4" Color="ThemeColor.Secondary" OnClick="() => _minLength = 4" data-testid="min-length-4" />
<HxButton Text="Static strong" Color="ThemeColor.Secondary" OnClick="() => _staticStrength = PasswordStrengthLevel.Strong" data-testid="static-strong" />
<HxButton Text="Dynamic" Color="ThemeColor.Secondary" OnClick="() => _staticStrength = null" data-testid="dynamic" />

@code {
	private string _password;
	private int _minLength = 8;
	private PasswordStrengthLevel? _staticStrength;
	private PasswordStrengthLevel? _strength;

	private void HandleStrengthChanged(PasswordStrengthChangedEventArgs args)
	{
		_strength = args.Strength;
	}
}
