<Project>

	<PropertyGroup>
		<Company>HAVIT, s.r.o.</Company>
		<Copyright>Copyright HAVIT, s.r.o.</Copyright>
		<VersionPrefix>2.0.0</VersionPrefix>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<Product>HAVIT Blazor Library</Product>
		<AssemblyTitle>HAVIT Blazor Library</AssemblyTitle>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- New Blazor analyzers introduced with the .NET 11 SDK; suppressed until the findings are addressed in the code:
			BL0011: Virtualize ItemsProvider usage
			BL0012: unnecessary StateHasChanged
			BL0016: JS interop call not guarded with try/catch -->
		<NoWarn>$(NoWarn);BL0011;BL0012;BL0016</NoWarn>

		<!-- aligned NuGet PackageVersion for package-bundles -->
		<ComponentsPackagesVersion>4.30.0-pre01</ComponentsPackagesVersion>
		<GrpcPackagesVersion>1.8.11</GrpcPackagesVersion>
		<ApplicationInsightsPackageVersion>1.1.2</ApplicationInsightsPackageVersion>
		<StoragePackagesVersion>1.0.5</StoragePackagesVersion>
		<LocalizationPackagesVersion>3.1.3</LocalizationPackagesVersion>

		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
	</PropertyGroup>

	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))"/>

</Project>