@attribute [Route(NavigationRoutes.PageViewTracking.AutoRouteTrackingPage2)]
@rendermode InteractiveServerWithoutPrerendering
@inject IBlazorApplicationInsights AppInsights

@code
{
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// sentinel for the tests asserting that NO page view was sent on navigation - see TestDefaults.SentinelEvents
			await AppInsights.TrackEventAsync(new EventTelemetry { Name = TestDefaults.SentinelEvents.AutoRouteTrackingPage2Done });
			await AppInsights.FlushAsync();
		}
	}
}
