@attribute [Route(NavigationRoutes.PageViewTracking.InitialPageViewTrackingTest)]
@rendermode InteractiveServerWithoutPrerendering
@inject IBlazorApplicationInsights AppInsights

<HxApplicationInsights />

@code
{
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// sentinel for the tests asserting that NO page view was sent - see TestDefaults.SentinelEvents
			await AppInsights.TrackEventAsync(new EventTelemetry { Name = TestDefaults.SentinelEvents.InitialPageViewTrackingPageDone });
			await AppInsights.FlushAsync();
		}
	}
}
